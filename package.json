{
  "name": "flyoff",
  "productName": "Flyoff",
  "version": "0.1.0",
  "description": "A private, extensible desktop notes application.",
  "private": true,
  "license": "UNLICENSED",
  "main": ".webpack/main",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native --pool=threads",
    "test:watch": "vitest --configLoader native --pool=threads",
    "test:twine-agent": "vitest run tests/unit/twine-e2e-model-client.test.ts tests/unit/twine-diagram-generation-loop.test.ts tests/unit/twine-note-agent.test.ts tests/unit/twine-diagram-agent.test.ts tests/unit/note-agent-operations.test.ts tests/unit/diagram-agent-operations.test.ts --configLoader native --pool=threads",
    "test:native": "npm run test --workspace=@flyoff/native-core",
    "test:e2e": "playwright test",
    "test:e2e:twine-agent": "playwright test tests/e2e/twine-document-agent.spec.ts",
    "assets:twemoji": "node scripts/sync-twemoji-assets.mjs",
    "seed:apollo-11": "tsx scripts/seed-apollo-11.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:native"
  },
  "dependencies": {
    "@flyoff/native-core": "0.1.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/nunito-sans": "5.2.7",
    "@google/genai": "^2.13.0",
    "@twemoji/parser": "17.0.2",
    "dictionary-en": "4.0.0",
    "dictionary-pt": "4.0.0",
    "hunspell-wasm": "0.3.0",
    "i18next": "26.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/webpack-env": "1.18.8",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "css-loader": "7.1.4",
    "electron": "43.1.0",
    "emojibase-data": "17.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "node-loader": "2.1.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.1"
  }
}
