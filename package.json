{
  "name": "flyoff",
  "productName": "Flyoff",
  "version": "0.1.0",
  "description": "A private, extensible desktop notes application.",
  "private": true,
  "license": "UNLICENSED",
  "main": ".webpack/main",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "prestart": "npm run native:build",
    "start": "node --max-old-space-size=3072 ./node_modules/@electron-forge/cli/dist/electron-forge-start.js",
    "prepackage": "npm run typecheck && npm run native:build",
    "package": "node --max-old-space-size=3072 ./node_modules/@electron-forge/cli/dist/electron-forge-package.js",
    "premake": "npm run typecheck && npm run native:build",
    "make": "node --max-old-space-size=3072 ./node_modules/@electron-forge/cli/dist/electron-forge-make.js",
    "make:windows:zip": "npm run typecheck && npm run native:build:windows && node --max-old-space-size=3072 ./node_modules/@electron-forge/cli/dist/electron-forge-make.js --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip && npm run native:build",
    "publish": "node --max-old-space-size=3072 ./node_modules/@electron-forge/cli/dist/electron-forge-publish.js",
    "setup:windows-cross": "bash scripts/setup-windows-cross.sh",
    "native:build": "npm run build --workspace=@flyoff/native-core",
    "native:build:windows": "npm run build:windows --workspace=@flyoff/native-core",
    "native:check": "npm run check --workspace=@flyoff/native-core",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native --pool=threads --maxWorkers=2",
    "test:watch": "vitest --configLoader native --pool=threads",
    "test:native": "npm run native:check && npm run native:build && npm run test --workspace=@flyoff/native-core",
    "test:twine-live": "node --env-file=.env.local --import tsx scripts/evaluate-twine-live.ts",
    "test:e2e": "playwright test",
    "diagnose:performance": "node scripts/run-packaged-performance-diagnostic.mjs",
    "benchmark:large-notes": "electron --no-sandbox --ozone-platform=headless --disable-gpu scripts/benchmark-large-notes.cjs",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "benchmark:scroll-anchor": "electron --no-sandbox --ozone-platform=headless --disable-gpu scripts/scroll-anchor-probe.cjs",
    "profile:keystroke": "electron --no-sandbox --ozone-platform=headless --disable-gpu scripts/keystroke-latency.cjs",
    "profile:keystroke-allocation": "electron scripts/keystroke-allocation.cjs",
    "assets:twemoji": "node scripts/sync-twemoji-assets.mjs",
    "seed:apollo-11": "tsx scripts/seed-apollo-11.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:native"
  },
  "dependencies": {
    "@flyoff/native-core": "0.1.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/nunito-sans": "5.2.7",
    "@google/genai": "^2.13.0",
    "@twemoji/parser": "17.0.2",
    "dictionary-en": "4.0.0",
    "dictionary-pt": "4.0.0",
    "hunspell-wasm": "0.3.0",
    "i18next": "26.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/webpack-env": "1.18.8",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "css-loader": "7.1.4",
    "electron": "^43.2.0",
    "emojibase-data": "17.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "monaco-editor": "^0.55.1",
    "node-loader": "2.1.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.1"
  }
}
