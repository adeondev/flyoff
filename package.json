{
  "name": "flyoff",
  "productName": "Flyoff",
  "version": "0.1.0",
  "description": "A private, extensible desktop notes application.",
  "private": true,
  "license": "UNLICENSED",
  "main": ".webpack/main",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native --pool=threads",
    "test:watch": "vitest --configLoader native --pool=threads",
    "test:native": "npm run test --workspace=@flyoff/native-core",
    "test:twine-live": "node --env-file=.env.local --import tsx scripts/evaluate-twine-live.ts",
    "test:e2e": "playwright test",
    "assets:twemoji": "node scripts/sync-twemoji-assets.mjs",
    "seed:apollo-11": "tsx scripts/seed-apollo-11.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:native"
  },
  "dependencies": {
    "@flyoff/native-core": "0.1.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/nunito-sans": "5.2.7",
    "@google/genai": "^2.13.0",
    "@twemoji/parser": "17.0.2",
    "dictionary-en": "4.0.0",
    "dictionary-pt": "4.0.0",
    "hunspell-wasm": "0.3.0",
    "i18next": "26.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/webpack-env": "1.18.8",
    "@vercel/webpack-asset-relocator-loader": "1.11.0",
    "css-loader": "7.1.5",
    "electron": "44.5.1",
    "emojibase-data": "17.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "node-loader": "2.1.0",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  }
}
