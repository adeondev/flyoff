{
  "name": "@flyoff/native-core",
  "version": "0.1.0",
  "private": true,
  "description": "Native Rust core for Flyoff",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "Cargo.toml",
    "build.rs",
    "flyoff_native_core.node",
    "src",
    "scripts",
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "flyoff_native_core"
  },
  "scripts": {
    "build": "node scripts/run-napi.cjs build --release --dts target/native-core.d.ts -- --locked",
    "build:windows": "node scripts/run-napi.cjs build --release --dts target/native-core.d.ts --target x86_64-pc-windows-msvc --cross-compile -- --locked",
    "check": "node scripts/run-cargo.cjs fmt --all -- --check && node scripts/run-cargo.cjs clippy --all-targets -- -D warnings",
    "clean": "node scripts/run-cargo.cjs clean",
    "test": "node --test --test-isolation=none test/*.test.js"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.0"
  }
}
